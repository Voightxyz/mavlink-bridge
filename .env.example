# Voight: an "ingest" API key (create it in the dashboard).
VOIGHT_API_KEY=vk_...
VOIGHT_ENDPOINT=https://api.voight.xyz
# Label of the agent as it will appear in the dashboard.
VOIGHT_AGENT_ID=drone-mavlink

# The flight agent's model: any OpenAI-compatible endpoint.
LLM_API_KEY=sk-or-...
LLM_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL=anthropic/claude-sonnet-5.5
# Z.ai direct:
# LLM_BASE_URL=https://api.z.ai/api/paas/v4
# AGENT_MODEL=glm-5.3

# ArduPilot SITL
ARDUPILOT_DIR=~/ardupilot      # where ArduPilot is cloned and built (build/sitl/bin/arducopter)
SITL=spawn                     # spawn: start SITL here; external: connect to one already running
SITL_SPEEDUP=3                 # simulated seconds per real second
MAVLINK_PORT=5760

# Mission
FAULT=gnss_spoof               # gnss_spoof | none
FAULT_AT=0.6                   # mission progress (0..1) at which the spoofing starts
DECISION_EVERY=2               # real seconds between agent decisions
PORT=4200

# Set to 1 to print events instead of sending them (no keys needed).
VOIGHT_DRY_RUN=0
